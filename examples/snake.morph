whisper snake — a complete game written in Morpheus.
whisper Controls: W A S D to move, G toggles god mode, Q quits.
whisper Eat * (food) to grow. Every 5 foods is the next level (up to 10),
whisper and each level adds an enemy (X). In god mode you can eat enemies.

sovereign pair_eq(a, b) {
    signal (a[0] == b[0]) and (a[1] == b[1])
}

sovereign on_snake(x, y, snake) {
    let i = 0
    let hit = false
    loop i < len(snake) {
        when (snake[i][0] == x) and (snake[i][1] == y) {
            let hit = true
        }
        let i = i + 1
    }
    signal hit
}

sovereign free_spot(w, h, snake, food, enemies) {
    let spot = [random_int(1, w), random_int(1, h)]
    let tries = 0
    loop tries < 800 {
        let ok = true
        when on_snake(spot[0], spot[1], snake) { let ok = false }
        when (len(food) == 2) and pair_eq(spot, food) { let ok = false }
        let i = 0
        loop i < len(enemies) {
            when pair_eq(spot, enemies[i]) { let ok = false }
            let i = i + 1
        }
        when ok { signal spot }
        let spot = [random_int(1, w), random_int(1, h)]
        let tries = tries + 1
    }
    signal spot
}

sovereign draw(w, h, snake, food, enemies, level, score, god) {
    clear()
    let edge = "+"
    let i = 0
    loop i < w {
        let edge = edge ++ "-"
        let i = i + 1
    }
    print(edge ++ "+")
    let y = 1
    loop y <= h {
        let row = "|"
        let x = 1
        loop x <= w {
            let ch = " "
            when (len(food) == 2) and (x == food[0]) and (y == food[1]) { let ch = "*" }
            when (x == snake[0][0]) and (y == snake[0][1]) { let ch = "O" }
            let bi = 1
            loop bi < len(snake) {
                when (x == snake[bi][0]) and (y == snake[bi][1]) { let ch = "o" }
                let bi = bi + 1
            }
            let ei = 0
            loop ei < len(enemies) {
                when (x == enemies[ei][0]) and (y == enemies[ei][1]) { let ch = "X" }
                let ei = ei + 1
            }
            let row = row ++ ch
            let x = x + 1
        }
        print(row ++ "|")
        let y = y + 1
    }
    let bot = "+"
    let j = 0
    loop j < w {
        let bot = bot ++ "-"
        let j = j + 1
    }
    print(bot ++ "+")
    let status = "Level " ++ level ++ "/10   Score " ++ score ++ "   Length " ++ len(snake)
    when god { let status = status ++ "   [GOD MODE]" }
    print(status)
}

whisper ---- state: top-level `let` lives in the global scope, so it persists ----
let W = 30
let H = 16
let snake = [[15, 8], [14, 8], [13, 8]]
let dir = [1, 0]
let enemies = []
let food = []
let level = 1
let score = 0
let foods = 0
let god = false
let alive = true
let won = false

let food = free_spot(W, H, snake, food, enemies)

whisper ---- one frame: called by the host every tick with the latest key ----
sovereign frame(k) {
    when not alive {
        signal "over"
    }
    when won {
        signal "win"
    }

    when k == "q" { signal "over" }
    when k == "g" { let god = not god }
    when k == "w" { let dir = [0, -1] }
    when k == "s" { let dir = [0, 1] }
    when k == "a" { let dir = [-1, 0] }
    when k == "d" { let dir = [1, 0] }

    let head = snake[0]
    let nx = head[0] + dir[0]
    let ny = head[1] + dir[1]

    when (nx < 1) or (nx > W) or (ny < 1) or (ny > H) {
        when god {
            when nx < 1 { let nx = W }
            when nx > W { let nx = 1 }
            when ny < 1 { let ny = H }
            when ny > H { let ny = 1 }
        }
        dream {
            let alive = false
        }
    }

    let newhead = [nx, ny]

    when alive {
        whisper enemies wander one step and bounce off the walls
        let ei = 0
        loop ei < len(enemies) {
            let e = enemies[ei]
            let ed = random_int(0, 3)
            let ex = e[0]
            let ey = e[1]
            when ed == 0 { let ex = ex + 1 }
            when ed == 1 { let ex = ex - 1 }
            when ed == 2 { let ey = ey + 1 }
            when ed == 3 { let ey = ey - 1 }
            when ex < 1 { let ex = 1 }
            when ex > W { let ex = W }
            when ey < 1 { let ey = 1 }
            when ey > H { let ey = H }
            set(enemies, ei, [ex, ey])
            let ei = ei + 1
        }

        whisper hitting an enemy: fatal, unless god mode (then you eat it)
        let eaten = -1
        let ci = 0
        loop ci < len(enemies) {
            when pair_eq(newhead, enemies[ci]) {
                when god {
                    let eaten = ci
                }
                dream {
                    let alive = false
                }
            }
            let ci = ci + 1
        }
        when eaten >= 0 {
            remove_at(enemies, eaten)
            let score = score + 10
            let enemies = push(enemies, free_spot(W, H, snake, food, enemies))
        }

        whisper hitting yourself (not fatal in god mode)
        when not god {
            let si = 0
            loop si < len(snake) {
                when pair_eq(newhead, snake[si]) { let alive = false }
                let si = si + 1
            }
        }
    }

    when alive {
        unshift(snake, newhead)
        when (len(food) == 2) and pair_eq(newhead, food) {
            let score = score + 1
            let foods = foods + 1
            let food = free_spot(W, H, snake, [], enemies)
            when foods >= 5 {
                let foods = 0
                when level >= 10 {
                    let won = true
                }
                dream {
                    let level = level + 1
                    let enemies = push(enemies, free_spot(W, H, snake, food, enemies))
                }
            }
        }
        dream {
            pop(snake)
        }
    }

    draw(W, H, snake, food, enemies, level, score, god)

    when won {
        signal "win"
    }
    when not alive {
        signal "over"
    }
    signal ""
}
