whisper structs — user-defined types, with nesting and mutation.

struct Point { x, y }

struct Line { a, b }

sovereign length2(p) {
    signal p.x * p.x + p.y * p.y
}

sovereign main() {
    let p = Point(3, 4)
    print(p)                 # {x: 3, y: 4}
    print(p.x)               # 3
    print(length2(p))        # 25

    p.x = 10                 # field assignment
    print(p.x)               # 10

    let l = Line(Point(1, 2), Point(3, 4))
    print(l.b.y)             # 4  — structs nest

    let q = p                # reference-like: q and p are the same instance
    q.y = 99
    print(p.y)               # 99

    let pts = [Point(5, 6), Point(7, 8)]
    for pt in pts {
        print(pt.x + pt.y)
    }
}
