whisper ============================================================
whisper  MORPHEUS DUO - learn to code, one small step at a time.
whisper  Duolingo-style: one idea per unit, a one-line tip, short mixed
whisper  exercises (output / fill-the-blank / keyword / true-false),
whisper  instant feedback, a progress bar, and a graded build at the end.
whisper  Self-paced, no timers, locked until you clear a unit.
whisper  Run:  node morph.js play learn/morpheus_duo.morph
whisper ============================================================

sovereign tier_xp(t) {
    when t == "Expert" { signal 20 }
    when t == "Hard" { signal 15 }
    signal 10
}

# one plain line of teaching per unit, then short questions
let units = [
    { "name": "Values", "tip": "Numbers add with +, multiply with *. * goes first.", "ex": [
        { "tier": "Easy",   "kind": "output",  "q": "What does this print?", "code": "print(2 + 3 * 4)", "opts": ["14", "20", "24"], "ans": 1, "why": "3 * 4 = 12, then 2 + 12 = 14." },
        { "tier": "Medium", "kind": "output",  "q": "What does this print?", "code": "print(10 / 4)", "opts": ["2", "2.5", "3"], "ans": 2, "why": "Dividing gives a decimal: 10 / 4 = 2.5." },
        { "tier": "Hard",   "kind": "output",  "q": "What does this print?", "code": "print(7 % 3)", "opts": ["2", "1", "2.33"], "ans": 2, "why": "% gives the remainder: 7 = 2*3 + 1." },
        { "tier": "Expert", "kind": "keyword", "q": "Which word names a value's kind?", "code": "print(????(3))", "opts": ["kind", "type", "class"], "ans": 2, "why": "type(3) is number, type(\"hi\") is string." }
    ] },
    { "name": "Decisions", "tip": "when runs code if true. dream is else.", "ex": [
        { "tier": "Easy",   "kind": "output",  "q": "With x = 7, what prints?", "code": "when x > 5 { print(\"big\") } dream { print(\"small\") }", "opts": ["big", "small", "nothing"], "ans": 1, "why": "7 is more than 5, so big." },
        { "tier": "Medium", "kind": "keyword", "q": "Which word is the else?", "code": "when a { }  ???  { }", "opts": ["else", "dream", "otherwise"], "ans": 2, "why": "dream is else. dream when is else-if." },
        { "tier": "Hard",   "kind": "truefalse","q": "True or false: this prints big.", "code": "x = 5\nwhen x > 5 { print(\"big\") } dream { print(\"small\") }", "opts": ["True", "False"], "ans": 2, "why": "5 is not more than 5, so it prints small." },
        { "tier": "Expert", "kind": "output",  "q": "With n = 0, what prints?", "code": "when n > 0 { print(\"pos\") } dream when n < 0 { print(\"neg\") } dream { print(\"zero\") }", "opts": ["pos", "neg", "zero"], "ans": 3, "why": "Not more, not less, so the last dream runs." }
    ] },
    { "name": "Loops", "tip": "loop repeats while true. for x in list walks items.", "ex": [
        { "tier": "Easy",   "kind": "output",  "q": "How many times does it run?", "code": "let i = 0\nloop i < 3 { let i = i + 1 }", "opts": ["2", "3", "forever"], "ans": 2, "why": "i goes 0,1,2,3 - so three times." },
        { "tier": "Medium", "kind": "output",  "q": "What does this print?", "code": "for n in [1, 2, 3] { print(n) }", "opts": ["1 2 3", "0 1 2", "3"], "ans": 1, "why": "for visits each item in order." },
        { "tier": "Hard",   "kind": "keyword", "q": "Which word stops a loop early?", "code": "loop i < 9 { when i == 2 { ??? } }", "opts": ["stop", "break", "exit"], "ans": 2, "why": "break leaves the loop. continue skips one turn." },
        { "tier": "Expert", "kind": "output",  "q": "What does this print?", "code": "let s = 0\nfor n in [1, 2, 3, 4] { let s = s + n }\nprint(s)", "opts": ["4", "10", "24"], "ans": 2, "why": "1 + 2 + 3 + 4 = 10." }
    ] },
    { "name": "Lists & Maps", "tip": "A list is [1, 2, 3]. A map is {\"a\": 1} - keys in quotes.", "ex": [
        { "tier": "Easy",   "kind": "output",  "q": "What does this print?", "code": "let l = [1, 2, 3]\npush(l, 4)\nprint(len(l))", "opts": ["3", "4", "5"], "ans": 2, "why": "push adds one item, so the length is 4." },
        { "tier": "Medium", "kind": "output",  "q": "What does this print?", "code": "let m = {\"b\": 1, \"a\": 2}\nprint(m.keys())", "opts": ["[a, b]", "[b, a]", "[1, 2]"], "ans": 1, "why": "keys() returns the keys in order." },
        { "tier": "Hard",   "kind": "missing", "q": "Fill the blank so the key works.", "code": "let m = { ___: 1 }", "opts": ["a", "\"a\"", "[a]"], "ans": 2, "why": "Map keys go in quotes: {\"a\": 1}." },
        { "tier": "Expert", "kind": "output",  "q": "What does this print?", "code": "let m = {\"a\": 1}\nprint(m.get(\"z\", 0))", "opts": ["error", "0", "null"], "ans": 2, "why": "get(key, fallback) uses the fallback when the key is missing." }
    ] },
    { "name": "Text", "tip": "Strings have tools: upper, split, join, replace.", "ex": [
        { "tier": "Easy",   "kind": "output",  "q": "What does this print?", "code": "print(upper(\"ab\"))", "opts": ["AB", "ab", "error"], "ans": 1, "why": "upper makes it capitals." },
        { "tier": "Medium", "kind": "output",  "q": "What does this print?", "code": "print(split(\"a,b\", \",\"))", "opts": ["[a, b]", "a,b", "ab"], "ans": 1, "why": "split cuts the text into a list of parts." },
        { "tier": "Hard",   "kind": "missing", "q": "Fill the blank to glue a list into text.", "code": "print(___([\"a\", \"b\"], \"-\"))", "opts": ["glue", "join", "mix"], "ans": 2, "why": "join puts the list back together with a separator." },
        { "tier": "Expert", "kind": "output",  "q": "What does this print?", "code": "print(replace(\"aaa\", \"a\", \"b\"))", "opts": ["bba", "b", "bbb"], "ans": 3, "why": "replace swaps every match: aaa -> bbb." }
    ] },
    { "name": "Functions", "tip": "sovereign defines a function. signal gives back a value.", "ex": [
        { "tier": "Easy",   "kind": "output",  "q": "What does this print?", "code": "sovereign sq(x) { signal x * x }\nprint(sq(6))", "opts": ["12", "36", "error"], "ans": 2, "why": "signal x*x, so sq(6) = 36." },
        { "tier": "Medium", "kind": "keyword", "q": "Which word gives back a value?", "code": "sovereign f() { ??? 1 }", "opts": ["return", "signal", "give"], "ans": 2, "why": "signal is how a function returns." },
        { "tier": "Hard",   "kind": "output",  "q": "What does this print?", "code": "sovereign add(a, b) { signal a + b }\nprint(add(3, 4))", "opts": ["7", "34", "error"], "ans": 1, "why": "Two inputs: 3 + 4 = 7." },
        { "tier": "Expert", "kind": "output",  "q": "What does this print?", "code": "sovereign fib(n) { when n < 2 { signal n } signal fib(n-1) + fib(n-2) }\nprint(fib(6))", "opts": ["6", "8", "13"], "ans": 2, "why": "A function can call itself: fib(6) = 8." }
    ] },
    { "name": "Little Functions", "tip": "fn(x) { ... } makes a small function you can pass around.", "ex": [
        { "tier": "Easy",   "kind": "output",  "q": "What does this print?", "code": "let dbl = fn(x) { signal x * 2 }\nprint(dbl(21))", "opts": ["42", "21", "error"], "ans": 1, "why": "dbl doubles its input." },
        { "tier": "Medium", "kind": "keyword", "q": "Which word makes one of these small functions?", "code": "let f = ???(x) { signal x + 1 }", "opts": ["sovereign", "fn", "def"], "ans": 2, "why": "fn makes a small function value." },
        { "tier": "Hard",   "kind": "output",  "q": "What does this print?", "code": "let c = 0\nlet inc = fn() { let c = c + 1 signal c }\nprint(inc())\nprint(inc())", "opts": ["1 then 2", "1 then 1", "0 then 1"], "ans": 1, "why": "It remembers its own number between calls: 1, then 2." },
        { "tier": "Expert", "kind": "output",  "q": "What does this print?", "code": "let base = 5\nlet addb = fn(x) { signal x + base }\nlet base = 100\nprint(addb(1))", "opts": ["6", "101", "error"], "ans": 1, "why": "It kept a copy of base = 5, so 1 + 5 = 6." }
    ] },
    { "name": "Your Own Types", "tip": "struct makes your own kind of value with named parts.", "ex": [
        { "tier": "Easy",   "kind": "output",  "q": "What does this print?", "code": "struct P { x, y }\nlet p = P(2, 9)\nprint(p.y)", "opts": ["2", "9", "(2, 9)"], "ans": 2, "why": "p.y reads the part named y." },
        { "tier": "Medium", "kind": "output",  "q": "What does this print?", "code": "struct P { x }\nlet p = P(1)\np.x = 7\nprint(p.x)", "opts": ["1", "7", "error"], "ans": 2, "why": "You can change a part: p.x = 7." },
        { "tier": "Hard",   "kind": "output",  "q": "What does this print?", "code": "struct P { x, y }\nstruct L { a, b }\nlet l = L(P(1, 2), P(3, 4))\nprint(l.b.y)", "opts": ["2", "4", "error"], "ans": 2, "why": "They can hold others: l.b.y is 4." },
        { "tier": "Expert", "kind": "truefalse","q": "True or false: this prints 5.", "code": "struct P { x }\nlet a = P(1)\nlet b = a\nb.x = 5\nprint(a.x)", "opts": ["True", "False"], "ans": 1, "why": "Both names point to the same value, so a.x is also 5." }
    ] },
    { "name": "Staying Safe", "tip": "heal tries code; dream catches a problem. import pulls in another file.", "ex": [
        { "tier": "Easy",   "kind": "output",  "q": "What does this print?", "code": "heal { print(1 / 0) } dream { print(\"caught\") }", "opts": ["0", "caught", "error"], "ans": 2, "why": "Dividing by zero is a problem; dream catches it." },
        { "tier": "Medium", "kind": "keyword", "q": "Which block catches the problem?", "code": "heal { ... } ??? { ... }", "opts": ["dream", "catch", "else"], "ans": 1, "why": "heal tries; dream recovers." },
        { "tier": "Hard",   "kind": "truefalse","q": "True or false: a missing map key is okay.", "code": "let m = {\"a\": 1}\nprint(m[\"z\"])", "opts": ["True", "False"], "ans": 2, "why": "A missing key is a problem - safe way is m.get(\"z\", 0)." },
        { "tier": "Expert", "kind": "keyword", "q": "Which word pulls in another file?", "code": "??? \"mathlib.morph\"", "opts": ["load", "import", "open"], "ans": 2, "why": "import runs another file so you can use its functions." }
    ] },
    { "name": "Build An App", "tip": "You know the pieces. Now edit a file, pass the tests, and build it.", "ex": [
        { "tier": "Expert", "kind": "keyword", "q": "Which tool saves text to disk between runs?", "code": "????(\"notes.txt\", text)", "opts": ["print", "write_file", "push"], "ans": 2, "why": "write_file keeps the text for next time." }
    ] }
]

let save_path = "learn/duo_save.txt"
let xp = 0
let streak = 0
let best = 0
let cleared = []
let i = 0
loop i < len(units) { let cleared = push(cleared, 0) let i = i + 1 }

let save_str = ""
heal { save_str = read_file(save_path) } dream { save_str = "" }
when len(save_str) > 0 {
    let parts = split(save_str, ",")
    when len(parts) >= 2 {
        let xp = int(parts[0])
        let streak = int(parts[1])
        let j = 2
        loop (j < len(parts)) and (j - 2 < len(cleared)) {
            let cleared = set(cleared, j - 2, int(parts[j]))
            let j = j + 1
        }
    }
}

let screen = "title"
let mi = 0
let u = 0
let e = 0
let chosen = 0
let fbok = true
let msg = ""
let wrote = false

sovereign unlocked(n) {
    when n == 0 { signal true }
    signal cleared[n - 1] == 1
}

sovereign save() {
    let s = str(xp) ++ "," ++ str(streak)
    let k = 0
    loop k < len(cleared) { let s = s ++ "," ++ str(cleared[k]) let k = k + 1 }
    heal { write_file(save_path, s) } dream { }
}

sovereign reset_progress() {
    let xp = 0
    let streak = 0
    let k = 0
    loop k < len(cleared) { let cleared = set(cleared, k, 0) let k = k + 1 }
    save()
}

sovereign bar(done, total, width) {
    let fill = 0
    when total > 0 { let fill = (done * width) / total }
    let s = ""
    let k = 0
    loop k < width {
        when k < fill { let s = s ++ "#" } dream { let s = s ++ "-" }
        let k = k + 1
    }
    signal s
}

sovereign streak_word() {
    when streak >= 5 { signal "On fire!" }
    when streak >= 3 { signal "Nice streak!" }
    when streak >= 2 { signal "Keep going!" }
    signal "Nice!"
}

sovereign starter_text() {
    let t = "sovereign to_celsius(f) {\n"
    let t = t ++ "    whisper TODO: signal (f - 32) * 5 / 9\n"
    let t = t ++ "    signal 0\n"
    let t = t ++ "}\n"
    let t = t ++ "\nsovereign main() {\n"
    let t = t ++ "    print(to_celsius(32))\n"
    let t = t ++ "    print(to_celsius(212))\n"
    let t = t ++ "}\n"
    signal t
}

sovereign write_starter() {
    heal { write_file("learn/learner.morph", starter_text()) } dream { let msg = "Could not write the file." }
}

sovereign draw_title() {
    clear()
    print("")
    print("            M O R P H E U S   D U O")
    print("       learn to code, one small step at a time")
    print("")
    print("   Short lessons. Quick questions. A real app at the end.")
    print("")
    print("                PRESS SPACE to start")
    print("")
    when xp > 0 { print("   welcome back - XP " ++ xp) }
    print("")
    print("                Q to quit")
}

sovereign draw_map() {
    clear()
    print("MORPHEUS DUO")
    print("XP " ++ xp ++ "   streak " ++ streak)
    print("")
    let k = 0
    loop k < len(units) {
        let mark = "  "
        when cleared[k] == 1 { let mark = "ok" }
        when (cleared[k] == 0) and (not unlocked(k)) { let mark = "--" }
        let cursor = "   "
        when k == mi { let cursor = " > " }
        print(cursor ++ "[" ++ mark ++ "]  " ++ str(k + 1) ++ ". " ++ units[k]["name"])
        let k = k + 1
    }
    print("")
    when len(msg) > 0 { print(msg) }
    print("W/S move    ENTER pick    Q quit")
}

sovereign draw_ex() {
    clear()
    let ex = units[u]["ex"][e]
    print("Unit " ++ str(u + 1) ++ "/" ++ str(len(units)) ++ "  " ++ units[u]["name"] ++ "   [" ++ bar(e, len(units[u]["ex"]), 4) ++ "]")
    print("----------------------------------------------------------")
    when e == 0 { print("Tip: " ++ units[u]["tip"]) print("") }
    print(ex["q"])
    print("")
    when len(ex["code"]) > 0 { print("   " ++ ex["code"]) print("") }
    let o = ex["opts"]
    let n = 0
    loop n < len(o) { print("  " ++ str(n + 1) ++ ") " ++ o[n]) let n = n + 1 }
    print("")
    print("1 2 3 answer     B back     Q quit")
}

sovereign draw_fb() {
    clear()
    let ex = units[u]["ex"][e]
    when fbok {
        print("  " ++ streak_word() ++ "   +" ++ str(tier_xp(ex["tier"])) ++ " XP")
    } dream {
        print("  Not quite. The answer is " ++ str(ex["ans"]) ++ ".")
    }
    print("")
    print("  " ++ ex["why"])
    print("")
    print("ENTER for next     B back     Q quit")
}

sovereign draw_workspace() {
    clear()
    print("BUILD AN APP")
    print("==========================================================")
    print("You finished the lessons. Time to build something real.")
    print("")
    print("  1. Open  learn/learner.morph  and finish to_celsius")
    print("     so it really turns Fahrenheit into Celsius.")
    print("")
    print("  2. Run the checker to see if your code is right:")
    print("       node morph.js run learn/check_capstone.morph")
    print("")
    print("  3. When it passes, build your app:")
    print("       node morph.js build learn/learner.morph")
    print("")
    print("Your file looks like this:")
    print("----------------------------------------------------------")
    print(starter_text())
    print("----------------------------------------------------------")
    when len(msg) > 0 { print(msg) }
    print("C rewrite   M back   Q quit")
}

sovereign draw_help() {
    clear()
    print("HOW TO PLAY")
    print("----------------------------------------------------------")
    print("  W / S     move")
    print("  ENTER     pick / next")
    print("  1 2 3     answer")
    print("  B         go back")
    print("  Q         quit")
    print("")
    print("  Each unit teaches one small idea, then asks a few")
    print("  quick questions. Clear a unit to unlock the next one.")
    print("  Take your time - nothing is timed.")
    print("")
    print("ANY KEY to go back")
}

sovereign draw() {
    when screen == "title" { draw_title() }
    dream when screen == "map" { draw_map() }
    dream when screen == "help" { draw_help() }
    dream when screen == "ex" { draw_ex() }
    dream when screen == "fb" { draw_fb() }
    dream when screen == "workspace" { draw_workspace() }
}

sovereign frame(k) {
    when k == "q" { signal "over" }
    when k == "r" { reset_progress() let mi = 0 let screen = "title" let msg = "" signal "" }

    when screen == "title" {
        when (k == " ") or (k == "\n") { let screen = "map" }
        when k == "h" { let screen = "help" }
    }
    dream when screen == "help" {
        when k != "" { let screen = "map" }
    }
    dream when screen == "map" {
        when k == "w" { let mi = (mi + len(units) - 1) % len(units) let msg = "" }
        when k == "s" { let mi = (mi + 1) % len(units) let msg = "" }
        when k == "h" { let screen = "help" }
        when k == "b" { let screen = "title" }
        when (k == "\n") or (k == " ") {
            when unlocked(mi) {
                let u = mi
                let e = 0
                let msg = ""
                let screen = "ex"
            } dream {
                let msg = "Finish the units before this one."
            }
        }
    }
    dream when screen == "ex" {
        when k == "b" { let screen = "map" }
        when (k == "1") or (k == "2") or (k == "3") {
            let chosen = int(k)
            let ex = units[u]["ex"][e]
            when chosen == ex["ans"] {
                let xp = xp + tier_xp(ex["tier"])
                let streak = streak + 1
                when streak > best { let best = streak }
                let fbok = true
            } dream {
                let streak = 0
                let fbok = false
            }
            let screen = "fb"
            save()
        }
    }
    dream when screen == "fb" {
        when k == "b" { let screen = "ex" }
        when (k == "\n") or (k == " ") {
            let e = e + 1
            when e >= len(units[u]["ex"]) {
                let cleared = set(cleared, u, 1)
                let xp = xp + 25
                save()
                when u >= len(units) - 1 {
                    let screen = "workspace"
                    let wrote = false
                } dream {
                    let u = u + 1
                    let mi = u
                    let screen = "map"
                    let msg = "Unit cleared. Next one unlocked."
                }
            } dream {
                let screen = "ex"
            }
        }
    }
    dream when screen == "workspace" {
        when not wrote { write_starter() let wrote = true }
        when k == "c" { write_starter() let msg = "File rewritten." }
        when k == "m" { let screen = "map" }
    }

    draw()
    signal ""
}
