whisper ============================================================
whisper  MORPHORIA - an Aporia Nous game. Learn to code by playing.
whisper  Combo multipliers, ranks, a mascot, a winding path of units,
whisper  and a final build you pass with real tests.
whisper  Self-paced, no timers. One small idea per unit.
whisper  Run:  node morph.js play learn/morphoria.morph
whisper ============================================================

sovereign tier_xp(t) {
    when t == "Expert" { signal 20 }
    when t == "Hard" { signal 15 }
    signal 10
}

sovereign tier_index(t) {
    when t == "Expert" { signal 3 }
    when t == "Hard" { signal 2 }
    when t == "Medium" { signal 1 }
    signal 0
}

sovereign rank(xp) {
    when xp >= 1000 { signal "Morphmaster" }
    when xp >= 600 { signal "Shapeshifter" }
    when xp >= 300 { signal "Wanderer" }
    when xp >= 120 { signal "Sprout" }
    signal "Egg"
}

sovereign stars_str(n) {
    let s = ""
    let k = 0
    loop k < n { let s = s ++ "*" let k = k + 1 }
    loop k < 3 { let s = s ++ "-" let k = k + 1 }
    signal s
}

let units = [
    { "name": "Values", "tip": "Numbers add with +, multiply with *. * goes first.", "ex": [
        { "tier": "Easy",   "kind": "output", "concept": "precedence",   "q": "What does this print?", "code": "print(2 + 3 * 4)", "opts": ["14", "20", "24"], "ans": 1, "why": "3 * 4 = 12, then 2 + 12 = 14." },
        { "tier": "Medium", "kind": "output", "concept": "division",   "q": "What does this print?", "code": "print(10 / 4)", "opts": ["2", "2.5", "3"], "ans": 2, "why": "Dividing gives a decimal: 10 / 4 = 2.5." },
        { "tier": "Hard",   "kind": "output", "concept": "modulo",   "q": "What does this print?", "code": "print(7 % 3)", "opts": ["2", "1", "2.33"], "ans": 2, "why": "% gives the remainder: 7 = 2*3 + 1." },
        { "tier": "Expert", "kind": "keyword", "concept": "type-kind",  "q": "Which word names a value's kind?", "code": "print(????(3))", "opts": ["kind", "type", "class"], "ans": 2, "why": "type(3) is number, type(\"hi\") is string." }
    ] },
    { "name": "Decisions", "tip": "when runs code if true. dream is else.", "ex": [
        { "tier": "Easy",   "kind": "output", "concept": "when-true",   "q": "With x = 7, what prints?", "code": "when x > 5 { print(\"big\") } dream { print(\"small\") }", "opts": ["big", "small", "nothing"], "ans": 1, "why": "7 is more than 5, so big." },
        { "tier": "Medium", "kind": "keyword", "concept": "else-word",  "q": "Which word is the else?", "code": "when a { }  ???  { }", "opts": ["else", "dream", "otherwise"], "ans": 2, "why": "dream is else. dream when is else-if." },
        { "tier": "Hard",   "kind": "truefalse", "concept": "when-false","q": "True or false: this prints big.", "code": "x = 5\nwhen x > 5 { print(\"big\") } dream { print(\"small\") }", "opts": ["True", "False"], "ans": 2, "why": "5 is not more than 5, so it prints small." },
        { "tier": "Expert", "kind": "output", "concept": "else-if-chain",   "q": "With n = 0, what prints?", "code": "when n > 0 { print(\"pos\") } dream when n < 0 { print(\"neg\") } dream { print(\"zero\") }", "opts": ["pos", "neg", "zero"], "ans": 3, "why": "Not more, not less, so the last dream runs." }
    ] },
    { "name": "Loops", "tip": "loop repeats while true. for x in list walks items.", "ex": [
        { "tier": "Easy",   "kind": "output", "concept": "loop-count",   "q": "How many times does it run?", "code": "let i = 0\nloop i < 3 { let i = i + 1 }", "opts": ["2", "3", "forever"], "ans": 2, "why": "i goes 0,1,2,3 - so three times." },
        { "tier": "Medium", "kind": "output", "concept": "for-each",   "q": "What does this print?", "code": "for n in [1, 2, 3] { print(n) }", "opts": ["1 2 3", "0 1 2", "3"], "ans": 1, "why": "for visits each item in order." },
        { "tier": "Hard",   "kind": "keyword", "concept": "break-word",  "q": "Which word stops a loop early?", "code": "loop i < 9 { when i == 2 { ??? } }", "opts": ["stop", "break", "exit"], "ans": 2, "why": "break leaves the loop. continue skips one turn." },
        { "tier": "Expert", "kind": "output", "concept": "loop-sum",   "q": "What does this print?", "code": "let s = 0\nfor n in [1, 2, 3, 4] { let s = s + n }\nprint(s)", "opts": ["4", "10", "24"], "ans": 2, "why": "1 + 2 + 3 + 4 = 10." }
    ] },
    { "name": "Lists & Maps", "tip": "A list is [1, 2, 3]. A map is {\"a\": 1} - keys in quotes.", "ex": [
        { "tier": "Easy",   "kind": "output", "concept": "push-len",   "q": "What does this print?", "code": "let l = [1, 2, 3]\npush(l, 4)\nprint(len(l))", "opts": ["3", "4", "5"], "ans": 2, "why": "push adds one item, so the length is 4." },
        { "tier": "Medium", "kind": "output", "concept": "keys-order",   "q": "What does this print?", "code": "let m = {\"b\": 1, \"a\": 2}\nprint(m.keys())", "opts": ["[a, b]", "[b, a]", "[1, 2]"], "ans": 1, "why": "keys() returns the keys in order." },
        { "tier": "Hard",   "kind": "missing", "concept": "map-keys",  "q": "Fill the blank so the key works.", "code": "let m = { ___: 1 }", "opts": ["a", "\"a\"", "[a]"], "ans": 2, "why": "Map keys go in quotes: {\"a\": 1}." },
        { "tier": "Expert", "kind": "output", "concept": "get-default",   "q": "What does this print?", "code": "let m = {\"a\": 1}\nprint(m.get(\"z\", 0))", "opts": ["error", "0", "null"], "ans": 2, "why": "get(key, fallback) uses the fallback when the key is missing." }
    ] },
    { "name": "Text", "tip": "Strings have tools: upper, split, join, replace.", "ex": [
        { "tier": "Easy",   "kind": "output", "concept": "upper",   "q": "What does this print?", "code": "print(upper(\"ab\"))", "opts": ["AB", "ab", "error"], "ans": 1, "why": "upper makes it capitals." },
        { "tier": "Medium", "kind": "output", "concept": "split",   "q": "What does this print?", "code": "print(split(\"a,b\", \",\"))", "opts": ["[a, b]", "a,b", "ab"], "ans": 1, "why": "split cuts the text into a list of parts." },
        { "tier": "Hard",   "kind": "missing", "concept": "join",  "q": "Fill the blank to glue a list into text.", "code": "print(___([\"a\", \"b\"], \"-\"))", "opts": ["glue", "join", "mix"], "ans": 2, "why": "join puts the list back together with a separator." },
        { "tier": "Expert", "kind": "output", "concept": "replace",   "q": "What does this print?", "code": "print(replace(\"aaa\", \"a\", \"b\"))", "opts": ["bba", "b", "bbb"], "ans": 3, "why": "replace swaps every match: aaa -> bbb." }
    ] },
    { "name": "Functions", "tip": "sovereign defines a function. signal gives back a value.", "ex": [
        { "tier": "Easy",   "kind": "output", "concept": "call-return",   "q": "What does this print?", "code": "sovereign sq(x) { signal x * x }\nprint(sq(6))", "opts": ["12", "36", "error"], "ans": 2, "why": "signal x*x, so sq(6) = 36." },
        { "tier": "Medium", "kind": "keyword", "concept": "signal-word",  "q": "Which word gives back a value?", "code": "sovereign f() { ??? 1 }", "opts": ["return", "signal", "give"], "ans": 2, "why": "signal is how a function returns." },
        { "tier": "Hard",   "kind": "output", "concept": "two-args",   "q": "What does this print?", "code": "sovereign add(a, b) { signal a + b }\nprint(add(3, 4))", "opts": ["7", "34", "error"], "ans": 1, "why": "Two inputs: 3 + 4 = 7." },
        { "tier": "Expert", "kind": "output", "concept": "recursion",   "q": "What does this print?", "code": "sovereign fib(n) { when n < 2 { signal n } signal fib(n-1) + fib(n-2) }\nprint(fib(6))", "opts": ["6", "8", "13"], "ans": 2, "why": "A function can call itself: fib(6) = 8." }
    ] },
    { "name": "Little Functions", "tip": "fn(x) { ... } makes a small function you can pass around.", "ex": [
        { "tier": "Easy",   "kind": "output", "concept": "fn-value",   "q": "What does this print?", "code": "let dbl = fn(x) { signal x * 2 }\nprint(dbl(21))", "opts": ["42", "21", "error"], "ans": 1, "why": "dbl doubles its input." },
        { "tier": "Medium", "kind": "keyword", "concept": "fn-word",  "q": "Which word makes one of these small functions?", "code": "let f = ???(x) { signal x + 1 }", "opts": ["sovereign", "fn", "def"], "ans": 2, "why": "fn makes a small function value." },
        { "tier": "Hard",   "kind": "output", "concept": "closure-state",   "q": "What does this print?", "code": "let c = 0\nlet inc = fn() { let c = c + 1 signal c }\nprint(inc())\nprint(inc())", "opts": ["1 then 2", "1 then 1", "0 then 1"], "ans": 1, "why": "It remembers its own number between calls: 1, then 2." },
        { "tier": "Expert", "kind": "output", "concept": "capture-copy",   "q": "What does this print?", "code": "let base = 5\nlet addb = fn(x) { signal x + base }\nlet base = 100\nprint(addb(1))", "opts": ["6", "101", "error"], "ans": 1, "why": "It kept a copy of base = 5, so 1 + 5 = 6." }
    ] },
    { "name": "Your Own Types", "tip": "struct makes your own kind of value with named parts.", "ex": [
        { "tier": "Easy",   "kind": "output", "concept": "field-read",   "q": "What does this print?", "code": "struct P { x, y }\nlet p = P(2, 9)\nprint(p.y)", "opts": ["2", "9", "(2, 9)"], "ans": 2, "why": "p.y reads the part named y." },
        { "tier": "Medium", "kind": "output", "concept": "field-write",   "q": "What does this print?", "code": "struct P { x }\nlet p = P(1)\np.x = 7\nprint(p.x)", "opts": ["1", "7", "error"], "ans": 2, "why": "You can change a part: p.x = 7." },
        { "tier": "Hard",   "kind": "output", "concept": "nesting",   "q": "What does this print?", "code": "struct P { x, y }\nstruct L { a, b }\nlet l = L(P(1, 2), P(3, 4))\nprint(l.b.y)", "opts": ["2", "4", "error"], "ans": 2, "why": "They can hold others: l.b.y is 4." },
        { "tier": "Expert", "kind": "truefalse", "concept": "struct-ref","q": "True or false: this prints 5.", "code": "struct P { x }\nlet a = P(1)\nlet b = a\nb.x = 5\nprint(a.x)", "opts": ["True", "False"], "ans": 1, "why": "Both names point to the same value, so a.x is also 5." }
    ] },
    { "name": "Staying Safe", "tip": "heal tries code; dream catches a problem. import pulls in another file.", "ex": [
        { "tier": "Easy",   "kind": "output", "concept": "heal-catch",   "q": "What does this print?", "code": "heal { print(1 / 0) } dream { print(\"caught\") }", "opts": ["0", "caught", "error"], "ans": 2, "why": "Dividing by zero is a problem; dream catches it." },
        { "tier": "Medium", "kind": "keyword", "concept": "dream-word",  "q": "Which block catches the problem?", "code": "heal { ... } ??? { ... }", "opts": ["dream", "catch", "else"], "ans": 1, "why": "heal tries; dream recovers." },
        { "tier": "Hard",   "kind": "truefalse", "concept": "missing-key","q": "True or false: a missing map key is okay.", "code": "let m = {\"a\": 1}\nprint(m[\"z\"])", "opts": ["True", "False"], "ans": 2, "why": "A missing key is a problem - safe way is m.get(\"z\", 0)." },
        { "tier": "Expert", "kind": "keyword", "concept": "import-word",  "q": "Which word pulls in another file?", "code": "??? \"mathlib.morph\"", "opts": ["load", "import", "open"], "ans": 2, "why": "import runs another file so you can use its functions." }
    ] },
    { "name": "Boss: Build An App", "tip": "You know the pieces. Finish your file, pass the tests, build the app.", "ex": [
        { "tier": "Expert", "kind": "keyword", "concept": "write-file",  "q": "Which tool saves text to disk between runs?", "code": "????(\"notes.txt\", text)", "opts": ["print", "write_file", "push"], "ans": 2, "why": "write_file keeps the text for next time." }
    ] }
]

import "morphoria_core.morph"

let strength = {}
let last_seen = {}
let shaky = []
let badges = []

sovereign concepts_of(unit) {
    let cs = []
    let i = 0
    loop i < len(unit["ex"]) {
        let c = unit["ex"][i]["concept"]
        when not contains(cs, c) { let cs = push(cs, c) }
        let i = i + 1
    }
    signal cs
}

sovereign all_concepts() {
    let cs = []
    let i = 0
    loop i < len(units) {
        let j = 0
        loop j < len(units[i]["ex"]) {
            let c = units[i]["ex"][j]["concept"]
            when not contains(cs, c) { let cs = push(cs, c) }
            let j = j + 1
        }
        let i = i + 1
    }
    signal cs
}

sovereign strength_of(c) {
    when has(strength, c) { signal strength[c] }
    signal 0.5
}

sovereign set_strength(c, s) {
    let strength = put(strength, c, s)
}

sovereign readiness_of(unit) {
    let cs = concepts_of(unit)
    let vals = []
    let i = 0
    loop i < len(cs) { let vals = push(vals, strength_of(cs[i])) let i = i + 1 }
    signal vals
}

sovereign save() {
    let bs = join(badges, ",")
    let cs = all_concepts()
    let parts = []
    let i = 0
    loop i < len(cs) {
        let c = cs[i]
        let seen = 0
        when has(last_seen, c) { let seen = last_seen[c] }
        let parts = push(parts, c ++ ":" ++ str(strength_of(c)) ++ ":" ++ str(seen))
        let i = i + 1
    }
    let cstr = []
    let ci = 0
    loop ci < len(cleared) { let cstr = push(cstr, str(cleared[ci])) let ci = ci + 1 }
    let line = str(xp) ++ "|" ++ str(best) ++ "|" ++ bs ++ "|" ++ join(parts, ";") ++ "|" ++ join(cstr, ",")
    heal { write_file("learn/morphoria_save.txt", line) } dream { }
}

let xp = 0
let streak = 0
let best = 0
let combo = 0
let last_stars = 0
let cleared = []
let ever_wrong = {}
let ustars = []
let i = 0
loop i < len(units) { let cleared = push(cleared, 0) let i = i + 1 }
let si = 0
loop si < len(units) { let ustars = push(ustars, 0) let si = si + 1 }

let save_str = ""
heal { save_str = read_file("learn/morphoria_save.txt") } dream { save_str = "" }
when len(save_str) > 0 {
    when contains(save_str, "|") {
        let top = split(trim(save_str), "|")
        when len(top) >= 1 { let xp = int(top[0]) }
        when len(top) >= 2 { let best = int(top[1]) }
        when (len(top) >= 3) and (len(top[2]) > 0) { let badges = split(top[2], ",") }
        when len(top) >= 4 {
            let recs = split(top[3], ";")
            let r = 0
            loop r < len(recs) {
                let f = split(recs[r], ":")
                when len(f) == 3 {
                    let strength = put(strength, f[0], float(f[1]))
                    let last_seen = put(last_seen, f[0], float(f[2]))
                }
                let r = r + 1
            }
        }
        when len(top) >= 5 {
            let cpart = split(top[4], ",")
            let q = 0
            loop (q < len(cpart)) and (q < len(cleared)) {
                let cleared = set(cleared, q, int(cpart[q]))
                let q = q + 1
            }
        }
    } dream {
        let legacy = split(trim(save_str), ",")
        when len(legacy) >= 1 { let xp = int(legacy[0]) }
        when len(legacy) >= 2 { let best = int(legacy[1]) }
        let j = 2
        loop (j < len(legacy)) and (j - 2 < len(cleared)) {
            let cleared = set(cleared, j - 2, int(legacy[j]))
            let j = j + 1
        }
    }
}

let di = 0
let dcs = all_concepts()
loop di < len(dcs) {
    let c = dcs[di]
    let seen = 0
    when has(last_seen, c) { let seen = last_seen[c] }
    set_strength(c, apply_decay(strength_of(c), seen))
    let di = di + 1
}

let screen = "title"
let mi = 0
let u = 0
let e = 0
let fbok = true
let msg = ""
let wrote = false
let rev_items = []
let ri = 0
let solved_review = {}
let rev_all = 1
let rev_is_boss = 0

sovereign unlocked(n) {
    when n == 0 { signal true }
    signal cleared[n - 1] == 1
}

sovereign bar(done, total, width) {
    let fill = 0
    when total > 0 { let fill = (done * width) / total }
    let s = ""
    let k = 0
    loop k < width { when k < fill { let s = s ++ "#" } dream { let s = s ++ "-" } let k = k + 1 }
    signal s
}

sovereign praise() {
    when combo >= 5 { signal "UNSTOPPABLE!" }
    when combo >= 3 { signal "COMBO x" ++ str(combo) ++ "!" }
    when combo >= 2 { signal "Nice combo!" }
    signal "Nice!"
}

sovereign has_badge(bs, name) {
    for b in bs { when b == name { signal true } }
    signal false
}

sovereign award(bs, name) {
    when has_badge(bs, name) { signal bs }
    signal push(bs, name)
}

sovereign hud() {
    print("XP " ++ str(xp) ++ "  " ++ rank(xp) ++ "  " ++ units[u]["name"] ++ "  · " ++ str(len(badges)) ++ " badges")
}

sovereign starter_text() {
    let t = "sovereign to_celsius(f) {\n"
    let t = t ++ "    whisper TODO: signal (f - 32) * 5 / 9\n"
    let t = t ++ "    signal 0\n"
    let t = t ++ "}\n"
    let t = t ++ "\nsovereign main() {\n"
    let t = t ++ "    print(to_celsius(32))\n"
    let t = t ++ "    print(to_celsius(212))\n"
    let t = t ++ "}\n"
    signal t
}

sovereign write_starter() {
    heal { write_file("learn/learner.morph", starter_text()) } dream { let msg = "Could not write the file." }
}

sovereign draw_title() {
    clear()
    print("")
    print("      +========================================+")
    print("      |            M O R P H O R I A           |")
    print("      |        learn to code by playing        |")
    print("      +========================================+")
    print("")
    print("                 (o_o)   Morphy says hi!")
    print("")
    print("   Short lessons. Quick quests. Ranks and combos.")
    print("   Finish with a build you pass with real tests.")
    print("")
    print("               PRESS SPACE to adventure")
    print("")
    when xp > 0 { print("        welcome back, " ++ rank(xp) ++ " - XP " ++ xp) }
    print("")
    print("        an Aporia Nous game          Q to quit")
}

sovereign draw_map() {
    clear()
    print("MORPHORIA      XP " ++ str(xp) ++ "   rank " ++ rank(xp) ++ "   best combo streak " ++ str(best))
    print("----------------------------------------------------------")
    let k = 0
    loop k < len(units) {
        let indent = repeat("  ", k % 3)
        let node = "( )"
        when cleared[k] == 1 { let node = "[*]" }
        when (cleared[k] == 0) and (not unlocked(k)) { let node = "[x]" }
        let cur = "  "
        when k == mi { let cur = "> " }
        let tail = ""
        when cleared[k] == 1 { let tail = "   cleared" }
        print(indent ++ cur ++ node ++ " " ++ str(k + 1) ++ ". " ++ units[k]["name"] ++ tail)
        let k = k + 1
    }
    print("----------------------------------------------------------")
    when len(msg) > 0 { print(msg) }
    print("W/S move    ENTER play    Q quit")
}

sovereign draw_ex() {
    clear()
    let ex = units[u]["ex"][e]
    hud()
    print("[" ++ bar(e, len(units[u]["ex"]), 4) ++ "]  " ++ ex["tier"] ++ "          combo x" ++ str(combo))
    print("----------------------------------------------------------")
    when e == 0 { print("Tip: " ++ units[u]["tip"]) print("") }
    print(ex["q"])
    print("")
    when len(ex["code"]) > 0 { print("   " ++ ex["code"]) print("") }
    let o = ex["opts"]
    let n = 0
    loop n < len(o) { print("  " ++ str(n + 1) ++ ") " ++ o[n]) let n = n + 1 }
    print("")
    print("1 2 3 answer     B back     Q quit")
}

sovereign draw_fb() {
    clear()
    let ex = units[u]["ex"][e]
    hud()
    print("")
    when fbok {
        let bonus = 0
        when combo >= 2 { let bonus = combo * 2 }
        print("   (^_^)  " ++ praise() ++ "   +" ++ str(tier_xp(ex["tier"]) + bonus) ++ " XP")
    } dream {
        print("   (;_;)  Not quite. The answer is " ++ str(ex["ans"]) ++ ".")
    }
    print("")
    print("   " ++ ex["why"])
    print("")
    print("ENTER for next     B back     Q quit")
}

sovereign draw_celebrate() {
    clear()
    print("")
    print("            *   *   *")
    print("           *  * *  *")
    print("            *   *   *")
    print("")
    print("        UNIT CLEARED!   stars: " ++ stars_str(last_stars))
    print("")
    print("           (^o^)   Morphy is dancing!")
    print("")
    print("        XP " ++ str(xp) ++ "   rank " ++ rank(xp))
    print("")
    when len(badges) == 0 { print("        badges: none yet") } dream { print("        badges: " ++ join(badges, ", ")) }
    print("")
    print("ENTER to continue")
}

sovereign draw_workspace() {
    clear()
    print("BOSS: BUILD AN APP")
    print("==========================================================")
    print("You reached the end. Time to build something real.")
    print("")
    print("  1. Open  learn/learner.morph  and finish to_celsius")
    print("     so it really turns Fahrenheit into Celsius.")
    print("")
    print("  2. Run the checker to see if your code is right:")
    print("       node morph.js run learn/check_capstone.morph")
    print("")
    print("  3. When it passes, build your app:")
    print("       node morph.js build learn/learner.morph")
    print("")
    print("Your file right now:")
    print("----------------------------------------------------------")
    print(starter_text())
    print("----------------------------------------------------------")
    print("Your badges:")
    when len(badges) == 0 {
        print("  No badges yet.")
    } dream {
        let bi = 0
        loop bi < len(badges) { print("  * " ++ badges[bi]) let bi = bi + 1 }
    }
    print("")
    when len(msg) > 0 { print(msg) }
    print("C rewrite   M back   Q quit")
}

sovereign draw_help() {
    clear()
    print("HOW TO PLAY")
    print("----------------------------------------------------------")
    print("  W / S     move on the path")
    print("  ENTER     play / next")
    print("  1 2 3     answer a question")
    print("  B         go back")
    print("  Q         quit")
    print("")
    print("  Clear each unit to unlock the next.")
    print("  Right answers build a COMBO for bonus XP.")
    print("  Wrong answers just reset your combo. Nothing is timed.")
    print("")
    print("ANY KEY to go back")
}

sovereign weakest_of(unit) {
    let cs = concepts_of(unit)
    let worst = cs[0]
    let i = 0
    loop i < len(cs) {
        when strength_of(cs[i]) < strength_of(worst) { let worst = cs[i] }
        let i = i + 1
    }
    signal worst
}

whisper review buckets (read-only): weak <0.60 (not ready), mid 0.60-0.80, strong >=0.80.
sovereign weak_concepts(unit) {
    let cs = concepts_of(unit)
    let out = []
    let i = 0
    loop i < len(cs) {
        when strength_of(cs[i]) < 0.6 { let out = push(out, cs[i]) }
        let i = i + 1
    }
    signal out
}

sovereign mid_concepts(unit) {
    let cs = concepts_of(unit)
    let out = []
    let i = 0
    loop i < len(cs) {
        let s = strength_of(cs[i])
        when (s >= 0.6) and (s < 0.8) { let out = push(out, cs[i]) }
        let i = i + 1
    }
    signal out
}

sovereign strong_concepts(unit) {
    let cs = concepts_of(unit)
    let out = []
    let i = 0
    loop i < len(cs) {
        when strength_of(cs[i]) >= 0.8 { let out = push(out, cs[i]) }
        let i = i + 1
    }
    signal out
}

sovereign find_ex(unit, c) {
    let found = unit["ex"][0]
    let i = 0
    loop i < len(unit["ex"]) {
        when unit["ex"][i]["concept"] == c { let found = unit["ex"][i] }
        let i = i + 1
    }
    signal found
}

sovereign build_review(unit) {
    let picked = pick_review(weak_concepts(unit), mid_concepts(unit), strong_concepts(unit))
    let items = []
    let i = 0
    loop i < len(picked) {
        let ex = find_ex(unit, picked[i])
        let item = { "concept": picked[i], "tier": ex["tier"], "q": ex["q"], "code": ex["code"], "opts": ex["opts"], "ans": ex["ans"] }
        let items = push(items, item)
        let i = i + 1
    }
    signal items
}

sovereign concepts_of_many(unit_list) {
    let out = []
    for un in unit_list {
        for ex in un["ex"] { let out = push(out, ex["concept"]) }
    }
    signal out
}

sovereign find_ex_many(unit_list, c) {
    let found = unit_list[0]["ex"][0]
    for un in unit_list {
        for ex in un["ex"] {
            when ex["concept"] == c { let found = ex }
        }
    }
    signal found
}

whisper generic buckets over any concept-id list (read-only).
sovereign weak_of(cs) {
    let out = []
    let i = 0
    loop i < len(cs) {
        when strength_of(cs[i]) < 0.6 { let out = push(out, cs[i]) }
        let i = i + 1
    }
    signal out
}

sovereign mid_of(cs) {
    let out = []
    let i = 0
    loop i < len(cs) {
        let s = strength_of(cs[i])
        when (s >= 0.6) and (s < 0.8) { let out = push(out, cs[i]) }
        let i = i + 1
    }
    signal out
}

sovereign strong_of(cs) {
    let out = []
    let i = 0
    loop i < len(cs) {
        when strength_of(cs[i]) >= 0.8 { let out = push(out, cs[i]) }
        let i = i + 1
    }
    signal out
}

sovereign last_units(u) {
    let out = []
    let start = u - 2
    when start < 0 { let start = 0 }
    let i = start
    loop i <= u { let out = push(out, units[i]) let i = i + 1 }
    signal out
}

sovereign build_boss(unit_list) {
    let cs = concepts_of_many(unit_list)
    let picked = pick_review(weak_of(cs), mid_of(cs), strong_of(cs))
    let i = 0
    loop (i < len(cs)) and (len(picked) < 6) {
        when not contains(picked, cs[i]) { let picked = push(picked, cs[i]) }
        let i = i + 1
    }
    let items = []
    let j = 0
    loop j < len(picked) {
        let ex = find_ex_many(unit_list, picked[j])
        let item = { "concept": picked[j], "tier": ex["tier"], "q": ex["q"], "code": ex["code"], "opts": ex["opts"], "ans": ex["ans"] }
        let items = push(items, item)
        let j = j + 1
    }
    signal items
}

sovereign draw_gate_ready() {
    clear()
    print(units[u]["name"] ++ " — cleared!   stars: " ++ stars_str(ustars[u]))
    print("")
    print("   (^_^)  Morphy: you've got this.")
    print("")
    print("  P practice more      ENTER continue")
    print("")
    print("B back to map   Q quit")
}

sovereign draw_gate_shaky() {
    clear()
    print(units[u]["name"] ++ " — almost!   stars: " ++ stars_str(ustars[u]))
    print("")
    print("   (o_o)  Morphy: let's shore up " ++ weakest_of(units[u]) ++ ".")
    print("")
    print("  R quick review       ENTER continue anyway")
    print("")
    print("B back to map   Q quit")
}

sovereign draw_review() {
    clear()
    when rev_is_boss == 1 {
        print("Boss review — " ++ units[u]["name"] ++ "   (" ++ str(ri + 1) ++ "/" ++ str(len(rev_items)) ++ ")")
    } dream {
        print("Quick review — " ++ units[u]["name"] ++ "   (" ++ str(ri + 1) ++ "/" ++ str(len(rev_items)) ++ ")")
    }
    print("")
    let it = rev_items[ri]
    print(it["q"])
    print("")
    when len(it["code"]) > 0 { print("   " ++ it["code"]) print("") }
    let a = it["opts"]
    let i = 0
    loop i < len(a) { print("  [" ++ str(i + 1) ++ "] " ++ a[i]) let i = i + 1 }
    print("")
    print("Pick 1-" ++ str(len(a)) ++ ".")
}

sovereign draw_review_done() {
    clear()
    print("Review done — nice work.")
    print("")
    print("ENTER continue")
}

sovereign draw() {
    when screen == "title" { draw_title() }
    dream when screen == "map" { draw_map() }
    dream when screen == "help" { draw_help() }
    dream when screen == "ex" { draw_ex() }
    dream when screen == "fb" { draw_fb() }
    dream when screen == "gate_ready" { draw_gate_ready() }
    dream when screen == "gate_shaky" { draw_gate_shaky() }
    dream when screen == "review" { draw_review() }
    dream when screen == "review_done" { draw_review_done() }
    dream when screen == "celebrate" { draw_celebrate() }
    dream when screen == "workspace" { draw_workspace() }
}

sovereign frame(k) {
    when k == "q" { signal "over" }

    when screen == "title" {
        when (k == " ") or (k == "\n") { let screen = "map" }
        when k == "h" { let screen = "help" }
    }
    dream when screen == "help" {
        when k != "" { let screen = "map" }
    }
    dream when screen == "map" {
        when k == "w" { let mi = (mi + len(units) - 1) % len(units) let msg = "" }
        when k == "s" { let mi = (mi + 1) % len(units) let msg = "" }
        when k == "h" { let screen = "help" }
        when (k == "\n") or (k == " ") {
            when unlocked(mi) {
                let u = mi
                let e = 0
                let msg = ""
                let screen = "ex"
            } dream {
                let msg = "Beat the earlier units to unlock this one."
            }
        }
    }
    dream when screen == "ex" {
        when k == "b" { let screen = "map" }
        when (k == "1") or (k == "2") or (k == "3") {
            let ex = units[u]["ex"][e]
            let c = ex["concept"]
            let key = c ++ str(e)
            let first_try = not has(ever_wrong, key)
            let correct = int(k) == ex["ans"]
            when not correct { let ever_wrong = put(ever_wrong, key, 1) }
            let pre_str = strength_of(c)
            set_strength(c, strength_update(strength_of(c), correct, tier_index(ex["tier"]), first_try))
            when correct {
                let combo = combo + 1
                let bonus = 0
                when combo >= 2 { let bonus = combo * 2 }
                let xp = xp + tier_xp(ex["tier"]) + bonus
                when combo > best { let best = combo }
                let fbok = true
                let badges = award(badges, "First Steps")
                when combo >= 5 { let badges = award(badges, "Combo x5") }
                when pre_str < 0.4 { let badges = award(badges, "Comeback") }
            } dream {
                let combo = 0
                let fbok = false
                when not contains(shaky, c) { let shaky = push(shaky, c) }
            }
            let screen = "fb"
            save()
        }
    }
    dream when screen == "fb" {
        when k == "b" { let screen = "ex" }
        when (k == "\n") or (k == " ") {
            let e = e + 1
            when e >= len(units[u]["ex"]) {
                let vals = readiness_of(units[u])
                let stars = stars_of(vals)
                let ustars = set(ustars, u, stars)
                save()
                when is_ready(vals) { let screen = "gate_ready" } dream { let screen = "gate_shaky" }
            } dream {
                let screen = "ex"
            }
        }
    }
    dream when screen == "gate_ready" {
        when k == "p" { let screen = "review_open" }
        when (k == "\n") or (k == " ") {
            let last_stars = ustars[u]
            let cleared = set(cleared, u, 1)
            let xp = xp + 25
            when ustars[u] == 0 { let badges = award(badges, "Shapeshifter") }
            when u >= len(units) - 1 {
                let screen = "workspace"
                let wrote = false
            } dream when ((u + 1) % 3) == 0 {
                let rev_items = build_boss(last_units(u))
                let ri = 0
                let solved_review = {}
                let rev_all = 1
                let rev_is_boss = 1
                let screen = "review"
            } dream {
                let u = u + 1
                let mi = u
                let screen = "celebrate"
            }
            save()
        }
        when k == "b" { let screen = "map" }
    }
    dream when screen == "gate_shaky" {
        when k == "r" { let screen = "review_open" }
        when (k == "\n") or (k == " ") {
            let last_stars = ustars[u]
            let cleared = set(cleared, u, 1)
            let xp = xp + 25
            when ustars[u] == 0 { let badges = award(badges, "Shapeshifter") }
            when u >= len(units) - 1 {
                let screen = "workspace"
                let wrote = false
            } dream when ((u + 1) % 3) == 0 {
                let rev_items = build_boss(last_units(u))
                let ri = 0
                let solved_review = {}
                let rev_all = 1
                let rev_is_boss = 1
                let screen = "review"
            } dream {
                let u = u + 1
                let mi = u
                let screen = "celebrate"
            }
            save()
        }
        when k == "b" { let screen = "map" }
    }
    dream when screen == "review_open" {
        let rev_items = build_review(units[u])
        let ri = 0
        let solved_review = {}
        let rev_all = 1
        let rev_is_boss = 0
        let screen = "review"
    }
    dream when screen == "review" {
        when (k == "1") or (k == "2") or (k == "3") or (k == "4") {
            let it = rev_items[ri]
            let correct = int(k) == it["ans"]
            let c = it["concept"]
            let key = "rev:" ++ c ++ str(ri)
            let first_try = not has(solved_review, key)
            let pre_str = strength_of(c)
            when not correct { let solved_review = put(solved_review, key, 1) }
            set_strength(c, strength_update(strength_of(c), correct, tier_index(it["tier"]), first_try))
            when correct {
                let badges = award(badges, "First Steps")
                when pre_str < 0.4 { let badges = award(badges, "Comeback") }
            } dream {
                let rev_all = 0
            }
            let ri = ri + 1
            let screen = "review"
            when ri >= len(rev_items) {
                let vals = readiness_of(units[u])
                let ustars = set(ustars, u, stars_of(vals))
                when rev_all == 1 { let badges = award(badges, "Full Sweep") }
                save()
                let screen = "review_done"
            }
        }
    }
    dream when screen == "review_done" {
        when (k == "\n") or (k == " ") {
            when rev_is_boss == 1 {
                let badges = award(badges, "Boss Slayer")
                let xp = xp + 50
                let rev_is_boss = 0
                let u = u + 1
                let mi = u
                let screen = "celebrate"
                save()
            } dream {
                let vals = readiness_of(units[u])
                when is_ready(vals) { let screen = "gate_ready" } dream { let screen = "gate_shaky" }
            }
        }
    }
    dream when screen == "celebrate" {
        when (k == "\n") or (k == " ") { let screen = "map" }
    }
    dream when screen == "workspace" {
        when not wrote { write_starter() let wrote = true }
        when k == "c" { write_starter() let msg = "File rewritten." }
        when k == "m" { let screen = "map" }
    }

    draw()
    signal ""
}
